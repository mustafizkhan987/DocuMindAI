# =============================================================================
# DocuMind AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=DocuMind AI
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database (PostgreSQL) — will be configured in Task 16
DATABASE_URL=postgresql://user:password@localhost:5432/documind_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8000

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Future: AI Services (will be configured in later tasks)
# PADDLEOCR_LANG=en
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
