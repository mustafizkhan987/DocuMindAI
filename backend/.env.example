# DocuMind AI — Environment Configuration Example
# Copy this file to .env for local development

# Application Information
APP_NAME=DocuMind AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=True

# Security Configuration
# Change this secret key in production!
SECRET_KEY=dev-secret-key-change-in-production-32-chars-min

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
